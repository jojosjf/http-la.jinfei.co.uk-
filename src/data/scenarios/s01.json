  "events": [
    {
      "when": {
        "type": "start"
      },
      "talk": [
        {
          "who": "旁白",
          "text": "青川河畔。三年前，问剑峰一夜覆灭。此后九州，再无问剑宗。"
        },
        {
          "who": "shipojun",
          "text": "少主！前面就是青川渡，过了河，离天工宗的地界就不远了！"
        },
        {
          "who": "yunheng",
          "text": "说了多少次，别叫我少主。问剑宗都没了，哪来的少主。"
        },
        {
          "who": "suqinghan",
          "text": "……别出声。河对岸，有东西。"
        },
        {
          "who": "剑灵",
          "text": "小子，傀儡五具，领头的是血螳。凭你现在炼气的修为，硬拼就是送死。"
        },
        {
          "who": "yunheng",
          "text": "那就不硬拼。老头，你在剑里看着就行。"
        },
        {
          "who": "旁白",
          "text": "提示：移动后选「攻击」出手。「神通」消耗神识，可令攻击必中或伤害倍增。"
        }
      ]
    },
    {
      "when": {
        "type": "turn",
        "turn": 2
      },
      "talk": [
        {
          "who": "suqinghan",
          "text": "这些傀儡的核心里……有修士的气息。像是活人被锁在里面。"
        },
        {
          "who": "shipojun",
          "text": "什么？！天工宗这帮畜生，拿活人炼傀儡？！"
        },
        {
          "who": "剑灵",
          "text": "哼，比你想的还脏。先活下来，再去掀他们的老底。"
        }
      ]
    },
    {
      "when": {
        "type": "defeated",
        "who": "xuetang"
      },
      "talk": [
        {
          "who": "旁白",
          "text": "血螳的胸甲崩开，一截泛白的骨头滚落在泥里。"
        },
        {
          "who": "suqinghan",
          "text": "是修士的指骨。被炼成了傀儡的灵枢。"
        },
        {
          "who": "yunheng",
          "text": "……骨上刻着剑纹。是问剑宗的剑纹。"
        },
        {
          "who": "剑灵",
          "text": "三年前那一夜，被带走的，不只是你的剑骨。"
        }
      ]
    },
    {
      "when": {
        "type": "clear"
      },
      "talk": [
        {
          "who": "shipojun",
          "text": "少主，这骨头……"
        },
        {
          "who": "yunheng",
          "text": "天工宗在买卖灵骨。这一截，是从哪儿流出来的？"
        },
        {
          "who": "suqinghan",
          "text": "南边的百珍坊市，什么都买得到。也什么都卖得掉。"
        },
        {
          "who": "yunheng",
          "text": "那就去百珍市。顺着这根骨头，把买家和卖家都揪出来。"
        },
        {
          "who": "剑灵",
          "text": "想清楚了？进了坊市，就是和天工宗正面撕破脸。"
        },
        {
          "who": "yunheng",
          "text": "三年前他们就撕破了。我只是去讨债。"
        }
      ]
    }
  ]
}
